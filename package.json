{
  "name": "excalidraw-desktop",
  "//productName": "Read by Electron for app.name (menus, userData folder, User-Agent) and by electron-builder for the bundle.",
  "productName": "Excalidraw Desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Excalidraw for the macOS desktop, with a sidebar for switching between .excalidraw files",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:5178 && electron .\"",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build:renderer && electron-builder --mac --arm64",
    "dist:intel": "npm run build:renderer && electron-builder --mac --x64"
  },
  "//": "Everything is bundled into dist/ by Vite, so there are no runtime dependencies to ship inside the .app.",
  "dependencies": {},
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.amos.excalidraw-desktop",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "excalidraw",
        "name": "Excalidraw Drawing",
        "description": "Excalidraw Drawing",
        "role": "Editor",
        "rank": "Owner"
      },
      {
        "ext": "png",
        "name": "Excalidraw Drawing (PNG)",
        "description": "PNG with embedded Excalidraw scene",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "svg",
        "name": "Excalidraw Drawing (SVG)",
        "description": "SVG with embedded Excalidraw scene",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "json",
        "name": "Excalidraw Scene (JSON)",
        "description": "Excalidraw scene JSON",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "identity": null,
      "extendInfo": {
        "NSHighResolutionCapable": true
      }
    }
  }
}
